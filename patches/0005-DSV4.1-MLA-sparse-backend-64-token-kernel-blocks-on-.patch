From 5f6246e03f2e0cecd0524d3b44753fe327384194 Mon Sep 17 00:00:00 2001
From: dsv41-engram-disk <noreply@users.noreply.github.com>
Date: Wed, 21 Oct 2026 07:33:21 +0000
Subject: [PATCH 5/5] DSV4.1 MLA sparse backend: 64-token kernel blocks on
 SM120

---
 vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py b/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py
index a5ab09283..f0af985b6 100644
--- a/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py
+++ b/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py
@@ -25,6 +25,7 @@ from vllm.models.deepseek_v41.sparse_mla import (
     DeepseekV4SparseMLAMetadataBuilder,
     DeepseekV41SparseSWAMetadataBuilder,
 )
+from vllm.platforms import current_platform
 from vllm.platforms.interface import DeviceCapability
 from vllm.utils.flashinfer import flashinfer_trtllm_batch_decode_sparse_mla_dsv4
 from vllm.v1.attention.backend import (
@@ -115,6 +116,10 @@ class DeepseekV4FlashInferMLASparseBackend(DeepseekV4SparseMLABackend):
 
     @staticmethod
     def get_supported_kernel_block_sizes(kv_cache_spec=None) -> list[int | MultipleOf]:
+        # SM12x: FlashInfer sparse-MLA takes the page size at runtime, and the
+        # DeepGEMM indexer is limited to 32/64-row pages, so use 64-token blocks.
+        if current_platform.is_device_capability_family(120):
+            return [64]
         return [128]
 
     @staticmethod
