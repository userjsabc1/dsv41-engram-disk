+def engram_disk_enabled() -> bool:
+    """VLLM_ENGRAM_DISK=1: serve the Engram tables straight from the checkpoint
+    safetensors shards (mmap + page cache) instead of holding them in pinned
+    host memory. The weight iterator skips these tensors (see
+    model_loader/ep_weight_filter.py), so they are never read into RAM."""
+    return os.environ.get("VLLM_ENGRAM_DISK", "0") == "1"
+
+
+def _safetensors_tensor_span(
+    model_dir: str, tensor_name: str
+) -> tuple[str, int, int, str, list[int]]:
+    """(shard path, absolute byte offset, nbytes, dtype, shape) of one tensor
+    of a sharded safetensors checkpoint."""
+    with open(os.path.join(model_dir, "model.safetensors.index.json")) as f:
+        shard = json.load(f)["weight_map"][tensor_name]
+    path = os.path.join(model_dir, shard)
+    with open(path, "rb") as f:
+        header_len = struct.unpack("<Q", f.read(8))[0]
+        header = json.loads(f.read(header_len))
+    info = header[tensor_name]
+    start, end = info["data_offsets"]
+    return path, 8 + header_len + start, end - start, info["dtype"], info["shape"]
+
