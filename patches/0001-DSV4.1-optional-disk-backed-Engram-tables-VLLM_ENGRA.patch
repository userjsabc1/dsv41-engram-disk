+    # ------------------------------------------------------------------
+    # Disk-backed table (VLLM_ENGRAM_DISK=1)
+    # ------------------------------------------------------------------
+    def _init_disk_tables(self) -> None:
+        """mmap this rank's contiguous row range of `<prefix>.weight/.scale`
+        straight out of the checkpoint shard. Nothing is copied: the pages are
+        file-backed (reclaimable), unlike pinned host memory."""
+        model_dir, prefix = self.disk_source
+        scale_dim = self.dim // self.block_size
+        rows = self.part_num_embeddings
+        self._disk_mm: list[np.memmap] = []
+        views: list[torch.Tensor | None] = []
+        for suffix, width in (("weight", self.row_bytes), ("scale", scale_dim)):
+            path, offset, _, _, shape = _safetensors_tensor_span(
+                model_dir, f"{prefix}.{suffix}"
+            )
+            assert shape == [self.num_embeddings, width], (
+                f"{prefix}.{suffix}: checkpoint shape {shape} != "
+                f"{[self.num_embeddings, width]}"
+            )
+            if rows == 0:
+                views.append(None)
+                continue
+            mm = np.memmap(
+                path,
+                dtype=np.uint8,
+                mode="r",
+                offset=offset + self.vocab_start_idx * width,
+                shape=(rows, width),
+            )
+            try:  # no readahead: lookups are random rows
+                mm._mmap.madvise(mmap.MADV_RANDOM)
+            except (AttributeError, OSError, ValueError):
+                pass
+            self._disk_mm.append(mm)
+            with warnings.catch_warnings():
+                warnings.simplefilter("ignore")  # read-only numpy buffer
+                views.append(torch.from_numpy(mm))
+        self._disk_weight, self._disk_scale = views
+        max_tokens = get_current_vllm_config().scheduler_config.max_num_batched_tokens
+        n_stage = max(1, max_tokens * self.part_n_hash_cols)
+        self._disk_stage_w = torch.empty(
+            n_stage, self.row_bytes, dtype=torch.uint8
+        ).pin_memory()
+        self._disk_stage_s = torch.empty(
+            n_stage, scale_dim, dtype=torch.uint8
+        ).pin_memory()
+        self._disk_threads = int(os.environ.get("VLLM_ENGRAM_DISK_THREADS", "16"))
+        self._disk_pool = ThreadPoolExecutor(max_workers=self._disk_threads)
+        logger.info(
+            "Engram table served from disk: %d rows x %d (%s .weight at +%d), "
+            "%.2f GiB mapped per rank, %d reader threads",
+            rows,
+            self.dim,
+            prefix,
+            self.vocab_start_idx,
+            rows * (self.row_bytes + scale_dim) / 1024**3,
+            self._disk_threads,
+        )
+
+    def _disk_gather(self, idx: torch.Tensor, lo: int, hi: int) -> None:
+        torch.index_select(self._disk_weight, 0, idx, out=self._disk_stage_w[lo:hi])
+        torch.index_select(self._disk_scale, 0, idx, out=self._disk_stage_s[lo:hi])
+
+    def _disk_fetch(
+        self, uniq_cpu: torch.Tensor, device: torch.device
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Read the (sorted, unique) rows from the mmap with a thread pool into
+        the pinned staging buffer, then copy them to `device`."""
+        n = uniq_cpu.numel()
+        if n > self._disk_stage_w.shape[0]:
+            # Larger than the scheduler budget (e.g. gathered DP batches).
+            self._disk_stage_w = torch.empty(
+                n, self.row_bytes, dtype=torch.uint8
+            ).pin_memory()
+            self._disk_stage_s = torch.empty(
+                n, self.dim // self.block_size, dtype=torch.uint8
+            ).pin_memory()
+        if n < 512:
+            self._disk_gather(uniq_cpu, 0, n)
+        else:
+            chunk = max(256, -(-n // (self._disk_threads * 2)))
+            futures = [
+                self._disk_pool.submit(
+                    self._disk_gather, uniq_cpu[lo : lo + chunk], lo, min(n, lo + chunk)
+                )
+                for lo in range(0, n, chunk)
+            ]
+            for future in futures:
+                future.result()
+        # Blocking copy: the staging buffers are reused by the next lookup.
+        return self._disk_stage_w[:n].to(device), self._disk_stage_s[:n].to(device)
+
+    def _lookup_disk(
+        self, indices: torch.Tensor, out: torch.Tensor, background: bool
+    ) -> None:
+        """Same contract as the host-memory lookup, but the rows of a batch are
+        deduplicated on the GPU, read from disk, uploaded as one compact table,
+        and the unchanged Triton kernel gathers from that compact table."""
+        device = indices.device
+        scale_dim = self.dim // self.block_size
+        h0 = self.head_start
+        h1 = min(self.head_start + self.part_n_hash_cols, self.n_hash_cols)
+        ids = torch.full(indices.shape, -1, dtype=indices.dtype, device=device)
+        n_unique = 0
+        if h1 > h0 and self._disk_weight is not None:
+            local = indices[:, h0:h1].to(torch.int64) - self.vocab_start_idx
+            valid = (local >= 0) & (local < self.part_num_embeddings)
+            flat = local[valid]
+            if flat.numel():
+                uniq, inverse = torch.unique(flat, return_inverse=True)
+                n_unique = uniq.numel()
+                w_dev, s_dev = self._disk_fetch(uniq.cpu(), device)
+                compact = torch.full_like(local, -1)
+                compact[valid] = inverse
+                ids[:, h0:h1] = compact.to(indices.dtype)
+        if n_unique == 0:
+            w_dev = torch.zeros(1, self.row_bytes, dtype=torch.uint8, device=device)
+            s_dev = torch.zeros(1, scale_dim, dtype=torch.uint8, device=device)
+        weight = w_dev if self.packed_fp4 else w_dev.view(torch.float8_e4m3fn)
+        rows = indices.shape[0] * self.part_n_hash_cols
+        ids_stride_t, ids_stride_h = ids.stride()
+        tiles = triton.cdiv(rows, 16)
+        grid = min(tiles, self._num_sms // 2 if background else self._num_sms)
+        _engram_lookup_kernel[(grid,)](
+            weight,
+            s_dev,
+            ids,
+            ids,
+            out,
+            0,
+            max(n_unique, 1),
+            rows,
+            ids_stride_t,
+            ids_stride_h,
+            HEAD_START=self.head_start,
+            LOCAL_HEADS=self.part_n_hash_cols,
+            TOTAL_HEADS=self.n_hash_cols,
+            DIM=self.dim,
+            QUANT_BLOCK=self.block_size,
+            BLOCK_R=16,
+            GRID=grid,
+            SORTED=False,
+            PACKED=out.dtype == torch.uint8,
+            OUT_STRIDE=out.stride(0),
+            PACKED_FP4=self.packed_fp4,
+        )
+
